@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

interface Borrowable {
  + borrow(member : Member, borrowedOn : LocalDate) : Loan
  + isOnLoan() : boolean
  + placeHold(member : Member) : Hold
}

class BorrowableItem {
  - loanPeriodDays : int
  + getLoanPeriodDays() : int
  + borrow(member : Member, borrowedOn : LocalDate) : Loan
  + isOnLoan() : boolean
  + placeHold(member : Member) : Hold
}

class ReferenceItem

class Member {
  - memberNumber : String
  - lateFeeBalance : BigDecimal
  + logIn(memberNumber : String) : boolean
  + borrow(item : Borrowable, borrowedOn : LocalDate) : Loan
  + placeHold(item : Borrowable) : Hold
  + waiveLateFee() : void
}

class Librarian {
  + addItem(catalogue : Catalogue, item : Item) : void
  + waiveLateFee(member : Member) : void
}

class Catalogue {
  + addItem(item : Item) : void
  + findItem(catalogueNumber : String) : Item
}

class Loan {
  - borrowedOn : LocalDate
  - dueOn : LocalDate
  + getDueOn() : LocalDate
}

class Hold

Item <|-- BorrowableItem
Item <|-- ReferenceItem
Borrowable <|.. BorrowableItem
Catalogue "1" --> "0..*" Item : items by catalogue number
BorrowableItem "1" --> "0..1" Loan : currentLoan
BorrowableItem "1" --> "0..*" Hold : holds
Loan "0..*" --> "1" Member : borrower
Hold "0..*" --> "1" Member : requester
Hold "0..*" --> "1" BorrowableItem : item
Member ..> Borrowable : borrows / places holds
Librarian ..> Catalogue : adds items
Librarian ..> Member : waives fees

note right of BorrowableItem
  Books: loanPeriodDays = 21
  DVDs: loanPeriodDays = 7
  borrow requires no current loan.
  placeHold requires a current loan.
end note

note bottom of Catalogue
  Catalogue numbers must be unique.
end note

@enduml
